datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  email     String?  @unique
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model Account {
  accountNumber String?
  accountType   EnumAccountAccountType?
  balance       Float?
  createdAt     DateTime                @default(now())
  customer      Customer?               @relation(fields: [customerId], references: [id])
  customerId    String?
  id            String                  @id @default(cuid())
  transactions  Transaction[]
  updatedAt     DateTime                @updatedAt
}

model Loan {
  createdAt    DateTime            @default(now())
  customer     Customer?           @relation(fields: [customerId], references: [id])
  customerId   String?
  id           String              @id @default(cuid())
  interestRate Float?
  loanAmount   Float?
  loanStatus   EnumLoanLoanStatus?
  loanTerm     Int?
  updatedAt    DateTime            @updatedAt
}

model Transaction {
  account         Account?                        @relation(fields: [accountId], references: [id])
  accountId       String?
  amount          Float?
  createdAt       DateTime                        @default(now())
  date            DateTime?
  id              String                          @id @default(cuid())
  transactionType EnumTransactionTransactionType?
  updatedAt       DateTime                        @updatedAt
}

model Customer {
  accounts    Account[]
  createdAt   DateTime  @default(now())
  dateOfBirth DateTime?
  email       String?
  firstName   String?
  id          String    @id @default(cuid())
  lastName    String?
  loans       Loan[]
  phoneNumber String?
  updatedAt   DateTime  @updatedAt
}

enum EnumAccountAccountType {
  Option1
}

enum EnumLoanLoanStatus {
  Option1
}

enum EnumTransactionTransactionType {
  Option1
}
